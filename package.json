{
  "name": "tally-xml-ingestion",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service that ingests Tally XML and exposes normalized vouchers without losing parent-child ownership.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/db/migrate.js",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "dev": "tsx src/db/migrate.ts && tsx watch src/server.ts",
    "test": "vitest run",
    "test:docker": "docker compose run --rm --build test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
