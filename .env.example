# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
PORT=3000
DATABASE_URL=postgres://tally:tally@localhost:5433/tally
# Maximum accepted upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760
# Maximum XML element nesting depth accepted by the parser.
MAX_XML_DEPTH=64
# Server-side request timeout in milliseconds.
REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
